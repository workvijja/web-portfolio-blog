---
import { getEntry } from "astro:content";
import { Button } from "../ui/button";

const author = await getEntry("authors", "vijjasena");
const copyright = `© ${new Date().getFullYear().toString()} ${author?.data.name || ""}. All rights reserved.`;
const socials = Object.entries(author?.data.socials || {}).map(([k, v]) => ({
  label: k,
  href: v,
}));
---

<footer class="mt-auto">
  <!-- <div class="px-8 py-4 border-t border-border">
    <div class="container grid grid-cols-2 gap-8 lg:grid-cols-6">
      <div class="col-span-2 mb-8 lg:mb-0">
        <div class="flex items-center lg:justify-start">
          <a href={"/"}>
            <MainLogo />
          </a>
        </div>
        <p class="mt-4 text-sm font-medium text-muted-foreground">
          asdfasdfasdavas asdasdfasdf
        </p>
      </div>
      <FooterLinks sections={sections} />
    </div>
  </div> -->
  <div class="px-6 py-3 md:px-8 md:py-4 border-t border-border">
    <div
      class="flex container flex-wrap gap-2 md:gap-4 text-xs text-muted-foreground items-center"
    >
      <p class="basis-1/2 grow shrink-0">
        {copyright}
      </p>
      <ul class="shrink-0 flex gap-2 md:gap-4">
        {
          socials?.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <Button variant={"link"} size={"xs"}>
                  {link.label}
                </Button>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
