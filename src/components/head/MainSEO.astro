---
import { SEO } from "astro-seo";
import type { SEOProps } from "astro-seo";

interface Props extends SEOProps {}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || Astro.url).href;
const ogImageUrl = new URL("/og-banner.webp", Astro.site || Astro.url).href;

const pageTitle =
  "Vijjasena | Frontend Developer | React/Next, Vue/Nuxt, Angular, Astro";
const siteDescription =
  "Frontend focused Fullstack developer specializing in building high-performance web applications with React, Next.js, and clean UI architecture. Explore my site.";

const props = Astro.props;
---

<SEO
  title={pageTitle}
  description={siteDescription}
  canonical={canonicalUrl}
  charset="UTF-8"
  openGraph={{
    basic: {
      title: "Hire me please. i code",
      type: "website",
      image: ogImageUrl,
      url: canonicalUrl,
    },
    optional: {
      description: siteDescription,
      siteName: "Vijja's Site",
    },
    image: {
      alt: "A preview card for my professional frontend engineering portfolio showing featured projects and technical skillsets.",
      width: 1200,
      height: 630,
      type: "image/webp",
    },
  }}
  twitter={{
    card: "summary_large_image",
    title: "I can code. hire me please",
    description: siteDescription,
    image: ogImageUrl,
    imageAlt:
      "A preview card for my professional frontend engineering portfolio showing featured projects and technical skillsets.",
  }}
  {...props}
/>
