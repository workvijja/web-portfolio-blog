---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
const blogs = await getCollection("blog");
---

<BaseLayout>
  <Fragment slot="head">
    <title>Blogs</title>
  </Fragment>
  
  <h1>blogs</h1>
  <ul>
    {
      blogs.map((b) => (
        <li>
          <a href={`/blogs/${b.id}`}>{b.data.title}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
