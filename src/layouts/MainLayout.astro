---
import Footer from "@/components/layouts/Footer.astro";
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/layouts/Header.astro";
import Nav from "@/components/layouts/Nav.astro";
import MainSEO from "@/components/head/MainSEO.astro";
---

<BaseLayout>
  <slot name="head" slot="head">
    <MainSEO />
  </slot>

  <div class="flex flex-col min-h-screen w-full bg-secondary text-foreground">
    <Header>
      <Nav class="ml-auto" />
    </Header>
    <slot />
    <Footer />
  </div>
</BaseLayout>
